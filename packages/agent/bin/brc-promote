#!/usr/bin/env python3
"""Local operator entry point; the package's agent broker enforces session identity."""
from pathlib import Path
import os
import sys

package_root = Path(__file__).resolve().parents[1]
broker = package_root / "dist" / "core" / "helix-bios-control.py"
if not broker.is_file():
    raise SystemExit("BRC_PROMOTE=REFUSED; BRC agent package helper is missing")
os.execv(sys.executable, [sys.executable, str(broker), "cli", *sys.argv[1:]])
